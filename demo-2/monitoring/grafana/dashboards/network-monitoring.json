{
  "title": "Network Monitoring - Demo 2",
  "uid": "demo2-network-monitoring",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Hardware Resource - edge-gw",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "CPU Busy",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 - ssCpuIdle{instance=\"edge-gw\"}",
          "legendFormat": "CPU busy",
          "refId": "A"
        }
      ],
      "description": "CPU bận = 100 - ssCpuIdle (UCD-SNMP-MIB). Không dùng hrProcessorLoad vì net-snmp trong container không populate hrProcessorTable."
    },
    {
      "type": "gauge",
      "title": "RAM Used",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * (hrStorageUsed{instance=\"edge-gw\", hrStorageDescr=~\"(?i).*(physical memory|mem).*\"} / hrStorageSize{instance=\"edge-gw\", hrStorageDescr=~\"(?i).*(physical memory|mem).*\"})",
          "legendFormat": "RAM",
          "refId": "A"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "Disk Used (/)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "100 * (hrStorageUsed{instance=\"edge-gw\", hrStorageDescr=\"/\"} / hrStorageSize{instance=\"edge-gw\", hrStorageDescr=\"/\"})",
          "legendFormat": "Disk /",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Port Up/Down",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 200,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Port Status",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "Down",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "ifOperStatus{instance=\"edge-gw\", ifDescr=~\"eth1|eth2|eth3\"}",
          "legendFormat": "{{ifDescr}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Bang thong 2 kenh Internet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 300,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "WAN1 (eth1 -> isp1)",
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(ifHCInOctets{instance=\"edge-gw\", ifDescr=\"eth1\"}[1m]) * 8",
          "legendFormat": "In",
          "refId": "A"
        },
        {
          "expr": "rate(ifHCOutOctets{instance=\"edge-gw\", ifDescr=\"eth1\"}[1m]) * 8",
          "legendFormat": "Out",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WAN2 (eth2 -> isp2)",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ds"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "rate(ifHCInOctets{instance=\"edge-gw\", ifDescr=\"eth2\"}[1m]) * 8",
          "legendFormat": "In",
          "refId": "A"
        },
        {
          "expr": "rate(ifHCOutOctets{instance=\"edge-gw\", ifDescr=\"eth2\"}[1m]) * 8",
          "legendFormat": "Out",
          "refId": "B"
        }
      ]
    }
  ]
}