# Copy thành deploy/.env rồi đổi giá trị.
# Học viên KHÔNG cần mật khẩu này — Grafana đã bật anonymous Viewer.
# Mật khẩu chỉ dùng khi giảng viên cần sửa dashboard.
#
# Lưu ý: server publish Grafana qua HTTP (không TLS). Không đăng nhập admin
# qua Internet — dùng SSH tunnel:
#   ssh -L 8082:localhost:8082 ubuntu@clab.9ping.cloud
#   rồi mở http://localhost:8082/login
GF_ADMIN_PASSWORD=doi-mat-khau-nay
